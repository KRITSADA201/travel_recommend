# ฐานข้อมูล: ถ้าใส่ DATABASE_URL ระบบจะใช้ตัวนี้แทน SQLite
# เอาค่าจาก Render Dashboard -> เลือก Database ของคุณ -> Connect -> "External Database URL"
# ตัวอย่างรูปแบบ: postgresql://user:password@host/dbname
DATABASE_URL=your_render_postgres_url_here

SECRET_KEY=your_secret_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# LINE OAuth
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_REDIRECT_URI=http://127.0.0.1:5000/auth/line/callback

# Facebook OAuth
FB_APP_ID=your_fb_app_id
FB_APP_SECRET=your_fb_app_secret
FB_REDIRECT_URI=http://127.0.0.1:5000/auth/facebook/callback

# Mail (SMTP) - ใช้สำหรับส่งลิงก์ "ลืมรหัสผ่าน" ไปยังอีเมลผู้ใช้
# ถ้าไม่ตั้งค่าตัวใดตัวหนึ่งใน 3 ตัวนี้ (MAIL_SERVER / MAIL_USERNAME / MAIL_PASSWORD)
# ระบบจะไม่ส่งอีเมลจริง แต่จะแสดงลิงก์รีเซ็ตบนหน้าเว็บแทน
# ตัวอย่างสำหรับ Gmail: ต้องเปิด 2-Step Verification แล้วสร้าง App Password ที่
# https://myaccount.google.com/apppasswords แล้วใช้รหัส 16 หลักนั้นแทนรหัสผ่านปกติ
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_SENDER=your_email@gmail.com
